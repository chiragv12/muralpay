PORT=3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/muralpay?schema=public
MURAL_BASE_URL=https://api-staging.muralpay.com
MURAL_API_KEY=
MURAL_ORGANIZATION_ID=

# Optional: pin checkout deposits to a specific Mural account UUID when you have several.
# MURAL_ACCOUNT_ID=

# PEM public key from Mural when you create the webhook (use \n for newlines in .env).
# MURAL_WEBHOOK_PUBLIC_KEY=

# Local dev only — set to true to skip ECDSA verification (never in production).
# MURAL_WEBHOOK_SKIP_VERIFY=false
